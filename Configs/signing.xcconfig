// Optional local code-signing overlay for Mac targets that hold TCC grants.
// Scripts/sync-local-signing.sh writes signing.local.xcconfig when the
// "CallNotes Local Signing" identity is in the login keychain (stable
// designated requirement, hardened runtime off). A missing include is
// ignored: CODE_SIGN_STYLE stays Automatic (ad-hoc).
//
// Hardened runtime lives here, not in project.yml target settings: those
// stamp the pbxproj and beat this overlay. Default YES; the overlay sets NO
// because the local identity has no Team ID (library validation SIGABRT).
ENABLE_HARDENED_RUNTIME = YES
#include? "signing.local.xcconfig"
